{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QueryX",
  "version": "0.1.0",
  "identifier": "com.uulab.queryx",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QueryX",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzQzVEQjA4ODBFQzI5MkIKUldRcktleUFDTnZGTXlIZi9XcVZRd0sza1FKZFA1MkFtWE54M1M2MWkrWnFMNFZaYWRMSHAybVYK",
      "endpoints": [
        "https://github.com/uulab-official/queryx/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

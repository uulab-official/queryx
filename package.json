{
  "name": "queryx",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter @queryx/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:native": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "check:native": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings",
    "verify": "node scripts/verify-repo.mjs",
    "format": "pnpm exec biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "vitest": "^2.1.8"
  }
}
